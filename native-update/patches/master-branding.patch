 /*
  * main.cpp - startup routine for Veyon Master Application
  *
@@ -24,6 +25,15 @@
 
 #include <QApplication>
 #include <QSplashScreen>
+#include <QIcon>
+#include <QDir>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QJsonArray>
+#include "FeatureManager.h"
+#include <QTimer>
+#include <QCryptographicHash>
 
 #include "DocumentationFigureCreator.h"
 #include "VeyonMaster.h"
@@ -48,7 +58,17 @@ int main( int argc, char** argv )
 #endif
 
 	QSplashScreen splashScreen( QPixmap( QStringLiteral(":/master/splash.png") ) );
+	app.setWindowIcon( QIcon( QStringLiteral(":/master/bimleman-icon.png") ) );
+	app.setApplicationDisplayName( QStringLiteral("BIMLéman View Room") );
+	const bool selfTest = app.arguments().contains(QStringLiteral("--bimleman-self-test"));
+	const QString evidenceDir = qEnvironmentVariable("BIMLEMAN_EVIDENCE_DIR");
+	if (selfTest && evidenceDir.isEmpty()) { return 2; }
 	splashScreen.show();
+	app.processEvents();
+	if (selfTest) {
+		QDir().mkpath(evidenceDir);
+		splashScreen.grab().save(evidenceDir + QStringLiteral("/splash.png"));
+	}
 
 	if( MainWindow::initAuthentication() == false ||
 			MainWindow::initAccessControl() == false )
@@ -63,5 +83,29 @@ int main( int argc, char** argv )
 
 	masterCore.mainWindow()->show();
 
+	if (selfTest) {
+		QTimer::singleShot(1500, &app, [&]() {
+			auto window = masterCore.mainWindow();
+			QJsonObject report;
+			report.insert(QStringLiteral("title"), window->windowTitle());
+			report.insert(QStringLiteral("version"), VeyonCore::versionString());
+			report.insert(QStringLiteral("qt"), QString::fromLatin1(qVersion()));
+			QJsonArray features;
+			for (const auto& feature : VeyonCore::featureManager().features()) { features.append(feature.name()); }
+			report.insert(QStringLiteral("features"), features);
+			report.insert(QStringLiteral("iconLoaded"), !window->windowIcon().isNull());
+			report.insert(QStringLiteral("splashLoaded"), !splashScreen.pixmap().isNull());
+			for (const auto& resource : {QStringLiteral("bimleman-icon.png"), QStringLiteral("splash.png")}) {
+				QFile file(QStringLiteral(":/master/") + resource);
+				if (!file.open(QIODevice::ReadOnly)) { app.exit(3); return; }
+				report.insert(resource, QString::fromLatin1(QCryptographicHash::hash(file.readAll(), QCryptographicHash::Sha256).toHex()));
+			}
+			const bool screenshot = window->grab().save(evidenceDir + QStringLiteral("/main-window.png"));
+			QFile output(evidenceDir + QStringLiteral("/native-smoke.json"));
+			const bool ok = output.open(QIODevice::WriteOnly) && output.write(QJsonDocument(report).toJson()) > 0;
+			app.exit(ok && screenshot && window->windowTitle() == QStringLiteral("BIMLéman View Room") &&
+				!window->windowIcon().isNull() && !splashScreen.pixmap().isNull() ? 0 : 4);
+		});
+	}
 	return core.exec();
 }
